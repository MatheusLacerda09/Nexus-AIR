{
  "name": "Nexus Air - Relatórios agendados",
  "nodes": [
    {
      "parameters": {
        "content": "## Nexus Air - Relatórios agendados (v2)\n1. Credenciais: **Nexus API Key** (Header Auth, X-API-Key), **Servidor Oracle** (SSH) e **Gmail** (OAuth2) em cada nó.\n2. Nó **Config**: ajuste `base_url` (Docker no mesmo PC: http://host.docker.internal:5000).\n3. Rode antes o workflow *Nexus Air - Teste de conexão*.\n4. Ative (Active/Publish). Só UM workflow de relatórios pode ficar ativo.",
        "height": 260,
        "width": 460
      },
      "id": "nota",
      "name": "Leia primeiro",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        20
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "a-cada-minuto",
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "base_url",
              "value": "http://host.docker.internal:5000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Endereço do Nexus Air visto de dentro do n8n. Docker no mesmo PC: http://host.docker.internal:5000"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.base_url }}/api/n8n/agendamentos/devidos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "buscar-relatorios-devidos",
      "name": "Buscar relatórios devidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nexus API Key"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "itens",
        "options": {}
      },
      "id": "dividir-relatorios",
      "name": "Dividir relatórios",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "command": "={{ $json.comando }}",
        "cwd": "/"
      },
      "id": "executar-no-oracle",
      "name": "Executar no Oracle",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        880,
        300
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "sshPrivateKey": {
          "id": "",
          "name": "Servidor Oracle"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.code }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "@@FIM@@",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "script-terminou-bem",
      "name": "Script terminou bem?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.base_url }}/api/n8n/agendamentos/{{ $('Dividir relatórios').item.json.id }}/pdf",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "sendBody": false
      },
      "id": "gerar-pdf",
      "name": "Gerar PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nexus API Key"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Dividir relatórios').item.json.destinatarios }}",
        "subject": "={{ $('Dividir relatórios').item.json.assunto }}",
        "emailType": "html",
        "message": "={{ $('Dividir relatórios').item.json.mensagem_html }}",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          },
          "senderName": "Nexus Air"
        }
      },
      "id": "enviar-gmail",
      "name": "Enviar Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1760,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.base_url }}/api/n8n/agendamentos/{{ $('Dividir relatórios').item.json.id }}/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "jsonBody": "={{ { ok: true, mensagem: 'Enviado para ' + $('Dividir relatórios').item.json.destinatarios } }}",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json"
      },
      "id": "reportar-sucesso",
      "name": "Reportar sucesso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nexus API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m",
              "name": "mensagem",
              "type": "string",
              "value": "={{ ($json.error && ($json.error.message || JSON.stringify($json.error))) || $json.stderr || (typeof $json.code === 'number' ? ($json.code === 0 ? 'Saída do script incompleta (faltou @@FIM@@).' : 'Script retornou código ' + $json.code) : 'Falha sem detalhe.') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "montar-falha",
      "name": "Montar falha",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.base_url }}/api/n8n/agendamentos/{{ $('Dividir relatórios').item.json.id }}/resultado",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "jsonBody": "={{ { ok: false, mensagem: $json.mensagem } }}",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json"
      },
      "id": "reportar-falha",
      "name": "Reportar falha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nexus API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.base_url }}/api/n8n/agendamentos/{{ $('Dividir relatórios').item.json.id }}/coleta",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { stdout: $json.stdout } }}",
        "contentType": "json"
      },
      "id": "salvar-coleta",
      "name": "Salvar coleta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nexus API Key"
        }
      },
      "onError": "continueErrorOutput"
    }
  ],
  "connections": {
    "A cada minuto": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Buscar relatórios devidos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar relatórios devidos": {
      "main": [
        [
          {
            "node": "Dividir relatórios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dividir relatórios": {
      "main": [
        [
          {
            "node": "Executar no Oracle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Executar no Oracle": {
      "main": [
        [
          {
            "node": "Script terminou bem?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Montar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Script terminou bem?": {
      "main": [
        [
          {
            "node": "Salvar coleta",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Montar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar PDF": {
      "main": [
        [
          {
            "node": "Enviar Gmail",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Montar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Gmail": {
      "main": [
        [
          {
            "node": "Reportar sucesso",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Montar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar falha": {
      "main": [
        [
          {
            "node": "Reportar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Salvar coleta": {
      "main": [
        [
          {
            "node": "Gerar PDF",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Montar falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo",
    "executionTimeout": 1800,
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false
}